{
  "name": "aula01-csr",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Exemplo simples de Client-Side Rendering com Node.js + TypeScript (Aula 01).",
  "scripts": {
    "build:client": "esbuild src/main.ts --bundle --outfile=public/main.js --format=esm",
    "dev": "npm run build:client && tsx src/index.ts",
    "build": "npm run build:client && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.30",
    "@types/supertest": "^6.0.2",
    "esbuild": "^0.20.2",
    "supertest": "^6.3.4",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
