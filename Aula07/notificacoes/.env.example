# Copie para `.env` (`cp .env.example .env`).
DATABASE_URL="file:./dev.db"
PORT=3007

# Probabilidade (0 a 1) de o "provedor" de SMS falhar — útil para testar o retry.
SMS_FAILURE_RATE=0.2

# ---- Trabalho III ----
# "prisma" (padrão, usa DATABASE_URL) ou "memory" (Etapa 9: sobe sem banco).
PERSISTENCE=prisma

# Provedor de e-mail (Etapa 9): "console" (simulado, padrão), "ethereal"
# (Nodemailer + conta de teste criada na hora; precisa de internet) ou "smtp".
EMAIL_PROVIDER=console
# Só para EMAIL_PROVIDER=smtp (ex.: Mailtrap):
# SMTP_HOST="sandbox.smtp.mailtrap.io"
# SMTP_PORT=2525
# SMTP_USER=""
# SMTP_PASS=""

# "false" tira a latência simulada do SMS (150 ms) e do e-mail (300 ms).
# SIMULATE_LATENCY=false
