<!doctype html>
<html lang="pt-br">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= card.title %> - Detalhes</title>
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="bg-slate-100 min-h-screen p-6">
    <div class="max-w-lg mx-auto bg-white rounded-lg shadow p-6">
      <header class="mb-4 flex items-center justify-between">
        <h1 class="text-xl font-bold text-slate-800"><%= card.title %></h1>
        <span class="text-xs px-2 py-1 rounded-full <%= card.priorityBadgeClass %>">
          <%= card.priority %>
        </span>
      </header>

      <div class="space-y-3 text-sm text-slate-600">
        <p><strong>Coluna:</strong> <%= card.columnName %></p>
        <p><strong>Descrição:</strong> <%= card.description || 'Sem descrição' %></p>
      </div>

      <footer class="mt-6 pt-4 border-t flex justify-between">
        <a href="/" class="text-sm text-slate-600 hover:underline">&larr; Voltar ao quadro</a>
      </footer>
    </div>
  </body>
</html>
