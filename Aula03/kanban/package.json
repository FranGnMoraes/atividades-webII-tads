{
  "name": "aula03-kanban",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Aula 03 - template MVC (Express + EJS + Tailwind, banco em memória) de um quadro estilo Trello/Jira. Estado inicial: apenas a visualização do quadro hard-coded. Casos de uso ficam para a turma implementar.",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:e2e": "vitest run test/e2e",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "ejs": "^6.0.1",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/ejs": "^3.1.5",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.30",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^1.6.0",
    "supertest": "^6.3.4",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
