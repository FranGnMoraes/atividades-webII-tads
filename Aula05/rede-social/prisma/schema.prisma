generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// 1:N — um autor tem muitos posts.
model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  // Nunca a senha em texto puro — só o hash gerado pelo bcrypt
  // (ver src/auth/passwords.ts). Mesmo um vazamento do banco não expõe a senha.
  passwordHash String
  avatarUrl    String?
  createdAt    DateTime @default(now())
  // Trabalho II (extra 10): quando o usuário abriu o feed pela última vez.
  // Serve para contar as curtidas/comentários que chegaram depois disso.
  lastSeenAt   DateTime?

  posts        Post[]
  likes        Like[]
  comments     Comment[]
  commentLikes CommentLike[]

  // Autorrelação N:N — User segue User, via tabela de junção explícita
  // (precisa ser explícita porque tem duas relações diferentes com User:
  // "quem segue" e "quem é seguido").
  following Follow[] @relation("follower")
  followers Follow[] @relation("following")
}

model Follow {
  followerId  Int
  followingId Int
  createdAt   DateTime @default(now())

  follower  User @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
}

model Post {
  id        Int      @id @default(autoincrement())
  content   String
  createdAt DateTime @default(now())

  authorId Int
  author   User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  // N:N implícita — o Prisma cria e gerencia a tabela de junção sozinho.
  tags Tag[]

  // Trabalho II: a antiga coluna `imageUrl` (uma foto só) virou a relação
  // 1:N abaixo. A migration copia as URLs antigas para PostImage antes de
  // apagar a coluna, então nenhum post perde a foto.
  images   PostImage[]
  likes    Like[]
  comments Comment[]
}

// 1:N — um post tem várias fotos. `order` guarda a posição no carrossel.
// Continua guardando só a URL: o arquivo em si fica no ImageStorage.
model PostImage {
  id     Int    @id @default(autoincrement())
  url    String
  order  Int
  postId Int
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
}

// N:N explícita com atributo (createdAt), igual ao Follow: liga User e Post.
// A chave composta impede a mesma pessoa de curtir o mesmo post duas vezes.
model Like {
  userId    Int
  postId    Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
}

// 1:N com Post e com User. Diferente da curtida, a mesma pessoa pode
// comentar várias vezes no mesmo post, então a chave é um id próprio.
model Comment {
  id        Int      @id @default(autoincrement())
  content   String
  createdAt DateTime @default(now())

  authorId Int
  author   User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  postId   Int
  post     Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  likes CommentLike[]
}

// Mesma ideia do Like, só que ligando User e Comment.
model CommentLike {
  userId    Int
  commentId Int
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@id([userId, commentId])
}

model Tag {
  id    Int    @id @default(autoincrement())
  name  String @unique
  posts Post[]
}
